; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Microgame Framework"
run/main_scene="uid://da4hhvghhnoi8"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://dowbc4oitb623"

[autoload]

GameManager="*uid://caxigcjbd3chd"

[display]

window/size/always_on_top=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://ExampleGame/": "pink",
"res://Framework/": "gray",
"res://Framework/Assets/": "purple",
"res://Framework/Credits/": "orange",
"res://Framework/GameManager/": "yellow",
"res://Framework/LevelSelect/": "teal",
"res://Framework/MainMenu/": "green",
"res://Framework/Microgame/": "blue"
}

[input]

pause={
"deadzone": 0.2,
"events": []
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
