# ===========================
# GODOT 4+ ENGINE
# ===========================
.godot/
.nomedia
.import/
export.cfg
export_credentials.cfg
*.translation

# Mono/C#
.mono/
data_*/
mono_crash.*.json

# ===========================
# 3D ASSET PIPELINE (BLENDER)
# ===========================
# Godot 4 imports .blend files directly by calling a local Blender
# install in the background. The resulting import cache is written
# to .godot/imported/, already covered by the .godot/ rule above.
# Only Blender's own local backup and in-progress save files need
# to be ignored here.
*.blend[0-9]
*.blend@

# ===========================
# GODOT ANDROID BUILD
# ===========================
.bfg-report/
android/build/
android/.build_version
old_android/build/
old_android/.build_version
*.aar

